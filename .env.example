# Puerto de la aplicación
PORT=3000

# URI de MongoDB
MONGODB_URI=mongodb://root:example@localhost:27017/kambista?authSource=admin

# Secret de JWT
JWT_SECRET=change-me-in-real-environments

# Tiempo de expiración de JWT
JWT_EXPIRES_IN=15m

# URL de la API de cambio de moneda
EXCHANGE_RATE_API_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat

# Tiempo de espera de la API de cambio de moneda
EXCHANGE_RATE_TIMEOUT_MS=5000

# Tiempo de refresco de la API de cambio de moneda
EXCHANGE_RATE_REFRESH_MS=30000

# Habilitar sincronización de la API de cambio de moneda
EXCHANGE_RATE_SYNC_ENABLED=true

# Origen de CORS
CORS_ORIGIN=http://localhost:5173

# Credenciales de MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example